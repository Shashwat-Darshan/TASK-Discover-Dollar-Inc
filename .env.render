# ============================================
# RENDER.APP DEPLOYMENT - ENVIRONMENT VARIABLES
# ============================================
# 
# Copy this entire file and paste it into Render's 
# "Environment" section for each service
#
# ============================================
# FOR BACKEND SERVICE (crud-dd-backend)
# ============================================

# MongoDB Atlas Connection String
# STEPS TO GET THIS:
# 1. Go to https://mongodb.com/atlas
# 2. Sign up (FREE tier available)
# 3. Create a FREE cluster
# 4. Click "Connect"
# 5. Choose "Drivers"
# 6. Copy the connection string
# 7. Replace <username> and <password> with your Database User credentials
# 8. Replace <db-name> with: dd_db
# EXAMPLE: mongodb+srv://myuser:mypass@cluster0.abc123.mongodb.net/dd_db?retryWrites=true&w=majority
# PASTE YOUR STRING BELOW:
MONGODB_URL=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/dd_db?retryWrites=true&w=majority

# Node.js Environment
NODE_ENV=production

# Backend Server Port
PORT=8080

# ============================================
# FOR FRONTEND SERVICE (crud-dd-frontend)
# ============================================

# Backend API URL (Update after backend is deployed)
# Once backend is deployed, Render will give you a URL like:
# https://crud-dd-backend.onrender.com
# Paste that below:
BACKEND_URL=https://crud-dd-backend.onrender.com
DOCKER_USERNAME=shashwatxdarshan
DOCKER_PASSWORD=dckr_pat_5J839uKTjOTD3qE_kfwvibghr80