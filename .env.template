# MongoDB Atlas Connection
# Get this from MongoDB Atlas → Connect → Drivers
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://YOUR_MONGODB_ATLAS_CONNECTION_STRING_HERE

# Backend API Configuration
NODE_ENV=production
PORT=8080

# Frontend Configuration (for Render deployment)
BACKEND_URL=https://crud-dd-backend.onrender.com

# Docker Hub (if deploying with GitHub Actions)
DOCKER_USERNAME=your-docker-hub-username
DOCKER_PASSWORD=your-docker-hub-token-or-password
